# ASF DIGITAL PLATFORM - FRONTEND ENVIRONMENT CONFIGURATION
# Production Staging Backend: https://asf-digital-platform-backend.onrender.com
# CORS Whitelist: https://asf-futa-digittal-platform-frontend.vercel.app and localhost:3000

# Base API URL for backend endpoints (all backend API routes are prefixed with /api)
VITE_API_BASE_URL=https://asf-digital-platform-backend.onrender.com/api

# Enable client-side mock storage/services fallback when developing locally without backend
# Set to 'false' for real backend integration in staging and production
VITE_USE_MOCK_SERVICES=false

# Developer Tools Toggle (Set to 'false' in production)
VITE_ENABLE_DEV_TOOLS=false

