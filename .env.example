# ASF DIGITAL PLATFORM - FRONTEND ENVIRONMENT CONFIGURATION

# Public Base API URL for backend endpoints
# In production (e.g. Vercel), set this to your deployed backend API URL (e.g., https://api.asffuta.org/api)
VITE_API_BASE_URL=/api

# Cloudinary Media Base URL for image optimization & media transformations
VITE_CLOUDINARY_BASE_URL=https://res.cloudinary.com/asf-futa/image/upload

# Enable client-side mock storage/services fallback when backend is offline
# Set to 'false' in production when live backend API is connected
VITE_USE_MOCK_SERVICES=true

# Developer Tools Toggle (Set to 'false' in production)
VITE_ENABLE_DEV_TOOLS=false
